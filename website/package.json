{
  "name": "fraudulent-job-detection-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Research website + live risk checker for the leakage-safe fraudulent job detection ML pipeline (EMSCAD).",
  "scripts": {
